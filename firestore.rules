/**
 * Core Philosophy:
 * This ruleset implements a hybrid security model that combines strict user-ownership
 * with a global role-based system for administrators. User data is private and can only
 * be modified by the user themselves, while administrators are granted read-only access
 * to user profiles for support and moderation purposes.
 *
 * Data Structure:
 * - /users/{userId}: Stores private profile information for each user. Access is
 *   scoped directly to the user who owns the document.
 * - /roles_admin/{userId}: A lookup collection where the existence of a document
 *   signifies that the user with the corresponding {userId} has administrative privileges.
 *
 * Key Security Decisions:
 * - Admin by Existence: Administrator status is determined by the existence of a
 *   document in `/roles_admin/{auth.uid}`. This is a highly performant and secure
 *   pattern that avoids embedding roles in user documents or other collections.
 * - User Data Privacy: The `/users` collection cannot be listed by any client,
 *   preventing enumeration of all users in the application.
 * - Admin Privileges: Admins have read-only access to all user data but cannot
 *   modify or delete it. Management of the admin role collection itself is restricted
 *   to other existing admins.
 * - Self-Creation: Users can only create their own user document (`/users/{userId}`
 *   where `{userId}` matches their auth UID), establishing a secure ownership model
 *   from the start.
 *
 * Denormalization for Authorization:
 * This ruleset relies on path-based ownership for `/users/{userId}` documents, making
 * authorization checks fast and simple without needing to read the document's content.
 * The `/roles_admin` collection is a form of denormalization, storing authorization
 * state (admin status) in a separate, easily queryable location for security rules.
 * This avoids slow and costly `get()` calls within rules.
 *
 * Structural Segregation:
 * The separation of user data (`/users`) from authorization data (`/roles_admin`)
 * is a deliberate design choice. It creates a clear boundary, making the ruleset
 * easier to understand, maintain, and audit for security vulnerabilities.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the foundation of the user-ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the user making the request has an admin role.
     * Admin status is determined by the existence of a document in the
     * `roles_admin` collection corresponding to the user's UID.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Validates that the user document being created has an `id` field
     * that matches the document's ID in the path. This enforces relational
     * integrity from the moment of creation.
     */
    function hasCorrectUserIdOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Ensures that the `id` field of a user document cannot be changed
     * after the document has been created. This prevents re-assigning
     * a user profile to a different user.
     */
    function isUserIdImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description
     *   Manages user profile documents. Access is strictly controlled, allowing
     *   users to manage their own data. Admins are granted read-only access.
     * @path
     *   /users/{userId}
     * @allow
     *   - (get) A user reading their own profile: `auth.uid == 'user_abc'` reads `/users/user_abc`.
     *   - (get) An admin reading any user profile: `auth.uid == 'admin_xyz'` reads `/users/user_abc`.
     *   - (create) A new user creating their own profile: `auth.uid == 'new_user'` creates `/users/new_user`.
     *   - (update) A user updating their own profile: `auth.uid == 'user_abc'` updates `/users/user_abc`.
     * @deny
     *   - (get) A user trying to read another user's profile: `auth.uid == 'user_123'` reads `/users/user_456`.
     *   - (update) An admin trying to update a user's profile.
     *   - (list) Any user trying to list all documents in the `/users` collection.
     * @principle
     *   Restricts access to a user's own data tree (Path-based Ownership) and provides
     *   read-only access for users with a specific role (Admin).
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && hasCorrectUserIdOnCreate(userId);
      allow update: if isOwner(userId) && resource != null && isUserIdImmutable();
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description
     *   Manages admin role documents. The existence of a document in this collection
     *   grants a user admin privileges across the application. Only existing admins
     *   can view or modify documents in this collection.
     * @path
     *   /roles_admin/{userId}
     * @allow
     *   - (get) An admin checking if another user is an admin: `auth.uid == 'admin_A'` reads `/roles_admin/user_B`.
     *   - (list) An admin listing all other admins.
     *   - (create) An admin granting admin rights to another user: `auth.uid == 'admin_A'` creates `/roles_admin/user_B`.
     * @deny
     *   - (get, list, create, update, delete) Any non-admin user attempting any operation.
     * @principle
     *   Enforces Role-Based Access Control (RBAC) for a privileged operation (managing admins).
     *   Authorization is based on the role of the requester, not ownership of the data.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}